{
  "name": "nexo-dev",
  "productName": "Nexo Dev",
  "version": "1.0.9",
  "homepage": "https://dev.nexorealm.org",
  "description": "A lightweight code editor and project manager.",
  "main": "main.js",
  "author": "Nexoria",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac",
    "release": "electron-builder --win --publish always",
    "release:linux": "electron-builder --linux --publish always",
    "release:mac": "electron-builder --mac --publish always"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.3.4",
    "dompurify": "^3.4.12",
    "electron-updater": "^6.8.9",
    "libsodium-wrappers": "^0.8.4",
    "marked": "^18.0.7",
    "monaco-editor": "^0.50.0",
    "monaco-vim": "^0.4.4"
  },
  "build": {
    "appId": "com.nexorealm.nexodev",
    "productName": "Nexo Dev",
    "asar": false,
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "node_modules/monaco-editor/min/**/*",
      "!node_modules/monaco-editor/min-maps",
      "!node_modules/monaco-editor/esm",
      "!node_modules/monaco-editor/dev",
      "node_modules/marked/lib/marked.umd.js",
      "node_modules/dompurify/dist/purify.min.js",
      "node_modules/libsodium-wrappers/**/*",
      "node_modules/libsodium/**/*",
      "node_modules/monaco-vim/dist/monaco-vim.umd.js",
      "node_modules/electron-updater/**/*",
      "node_modules/builder-util-runtime/**/*",
      "node_modules/@xhayper/discord-rpc/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "itsnexoria",
      "repo": "nexo-dev",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "renderer/icons/icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "maintainer": "Nexoria <support@nexorealm.org>",
      "synopsis": "A lightweight code editor and project manager."
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "renderer/icons/logo-256.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh"
    }
  }
}
