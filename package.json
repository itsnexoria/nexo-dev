{
  "name": "nexo-dev",
  "productName": "Nexo Dev",
  "version": "1.1.1",
  "homepage": "https://dev.nexorealm.org",
  "description": "A lightweight code editor and project manager.",
  "main": "main.js",
  "author": "Nexoria",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "npm run build && electron-builder --win",
    "dist:portable": "npm run build && electron-builder --win portable",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:mac": "npm run build && electron-builder --mac",
    "release": "npm run build && electron-builder --win --publish always",
    "release:linux": "npm run build && electron-builder --linux --publish always",
    "release:mac": "npm run build && electron-builder --mac --publish always",
    "build": "node scripts/build.js",
    "watch": "node scripts/build.js --watch",
    "typecheck": "node scripts/gen-api.js && tsc -p tsconfig.json",
    "prestart": "npm run build",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "postinstall": "node scripts/build.js",
    "lint": "eslint .",
    "format": "prettier --check \"lib/**/*.js\" \"test/**/*.js\"",
    "test:coverage": "node --test --experimental-test-coverage test/*.test.js"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "globals": "^15.0.0"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@xhayper/discord-rpc": "^1.3.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.12",
    "electron-updater": "^6.8.9",
    "libsodium-wrappers": "^0.8.4",
    "marked": "^18.0.7",
    "monaco-editor": "^0.50.0",
    "monaco-vim": "^0.4.4",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "sql.js": "^1.15.0",
    "tsserver-host": "npm:typescript@^5.9.3",
    "typescript-language-server": "^5.3.0",
    "ws": "^8.22.0"
  },
  "build": {
    "appId": "com.nexorealm.nexodev",
    "productName": "Nexo Dev",
    "asar": false,
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "node_modules/monaco-editor/min/**/*",
      "!node_modules/monaco-editor/min-maps",
      "!node_modules/monaco-editor/esm",
      "!node_modules/monaco-editor/dev",
      "node_modules/marked/lib/marked.umd.js",
      "node_modules/dompurify/dist/purify.min.js",
      "node_modules/libsodium-wrappers/**/*",
      "node_modules/libsodium/**/*",
      "node_modules/monaco-vim/dist/monaco-vim.umd.js",
      "node_modules/electron-updater/**/*",
      "node_modules/builder-util-runtime/**/*",
      "node_modules/@xhayper/discord-rpc/**/*",
      "node_modules/@xterm/**/*",
      "node_modules/@lydell/**/*",
      "node_modules/sql.js/dist/*",
      "node_modules/typescript-language-server/**/*",
      "node_modules/tsserver-host/lib/**/*",
      "node_modules/tsserver-host/package.json",
      "!node_modules/**/*.map",
      "!renderer/features"
    ],
    "publish": {
      "provider": "github",
      "owner": "itsnexoria",
      "repo": "nexo-dev",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "renderer/icons/icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "maintainer": "Nexoria <support@nexorealm.org>",
      "synopsis": "A lightweight code editor and project manager."
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "renderer/icons/logo-256.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh"
    }
  }
}
